{
  "name": "semantic-release-jira-fixversion",
  "version": "1.0.0",
  "type": "module",
  "description": "semantic-release plugin to sync releases with Jira Server",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "jest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "semantic-release",
    "jira",
    "plugin"
  ],
  "author": "danbka33",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danbka33/semantic-release-jira-fixversion.git"
  },
  "homepage": "https://github.com/danbka33/semantic-release-jira-fixversion#readme",
  "bugs": {
    "url": "https://github.com/danbka33/semantic-release-jira-fixversion/issues"
  },
  "dependencies": {
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "semantic-release": "^24.2.9",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0"
  }
}
