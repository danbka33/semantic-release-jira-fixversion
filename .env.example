# Copy this file to .env.local to configure the docker-compose environment.
# The defaults target the bundled mock Jira server.

JIRA_BASE_URL=http://mock-jira:8080
JIRA_TOKEN=mock-token
# Uncomment to try basic auth instead of bearer tokens
# JIRA_AUTH_MODE=basic
# JIRA_USERNAME=admin
# JIRA_PASSWORD=admin
